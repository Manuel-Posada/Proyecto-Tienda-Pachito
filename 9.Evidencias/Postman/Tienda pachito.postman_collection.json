  "item": [
    {
      "name": "📦 Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/productos/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arroz 1kg\",\n  \"precio\": 2500,\n  \"stock\": 50,\n  \"stock_minimo\": 10,\n  \"emoji\": \"🌾\"\n}"
            },
            "url": "{{base_url}}/api/productos/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Producto creado con status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "let json = pm.response.json();",
                  "pm.collectionVariables.set(\"producto_id\", json.id);",
                  "console.log(\"producto_id guardado:\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver producto por ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/productos/{{producto_id}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arroz 1kg Premium\",\n  \"precio\": 3000,\n  \"stock_minimo\": 15\n}"
            },
            "url": "{{base_url}}/api/productos/{{producto_id}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Producto actualizado con status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Productos con stock bajo",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/alertas/stock/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/productos/{{producto_id}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Eliminado con status 204 o error controlado 400\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([204, 400]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "💰 Ventas",
      "item": [
        {
          "name": "Listar ventas",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/ventas/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ventas por fecha",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/ventas/?fecha={{fecha_hoy}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const hoy = new Date();",
                  "const fecha = hoy.getFullYear() + '-' +",
                  "  String(hoy.getMonth() + 1).padStart(2, '0') + '-' +",
                  "  String(hoy.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('fecha_hoy', fecha);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": {{producto_id}},\n  \"cantidad\": 2\n}"
            },
            "url": "{{base_url}}/api/ventas/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Venta registrada con status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
