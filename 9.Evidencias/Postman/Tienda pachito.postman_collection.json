    {
      "name": "📊 Reportes",
      "item": [
        {
          "name": "Reporte diario",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reportes/diario/?fecha={{fecha_hoy}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const hoy = new Date();",
                  "const fecha = hoy.getFullYear() + '-' +",
                  "  String(hoy.getMonth() + 1).padStart(2, '0') + '-' +",
                  "  String(hoy.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('fecha_hoy', fecha);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reporte por rango",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reportes/rango/?fecha_inicio={{fecha_inicio}}&fecha_fin={{fecha_hoy}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const hoy = new Date();",
                  "const fechaFin = hoy.getFullYear() + '-' +",
                  "  String(hoy.getMonth() + 1).padStart(2, '0') + '-' +",
                  "  String(hoy.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('fecha_hoy', fechaFin);",
                  "const inicio = new Date(hoy);",
                  "inicio.setDate(inicio.getDate() - 7);",
                  "const fechaInicio = inicio.getFullYear() + '-' +",
                  "  String(inicio.getMonth() + 1).padStart(2, '0') + '-' +",
                  "  String(inicio.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('fecha_inicio', fechaInicio);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
